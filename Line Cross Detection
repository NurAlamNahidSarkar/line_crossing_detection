put/datasets/nahidsarkar/newwalking/WhatsApp Video 2026-04-05 at 9.15.53 AM.mp4\"\nOUTPUT_PATH = \"/kaggle/working/newwalking2.mp4\"\n\n# ── Setup ─────────────────────────────────────────────────────────────────────\nmodel = YOLO(\"yolov8s.pt\")   # upgraded from nano → small\nmodel.to(DEVICE)\n\ncount_in      = 0\ncount_out     = 0\ntrack_history = {}\n\n# ── CSV log ───────────────────────────────────────────────────────────────────\ncsv_file   = open(\"/kaggle/working/crossings_log.csv\", \"w\", newline=\"\")\ncsv_writer = csv.writer(csv_file)\ncsv_writer.writerow([\"frame\", \"person_id\", \"direction\", \"total_in\", \"total_out\"])\n\n# ── Core math ─────────────────────────────────────────────────────────────────\ndef side_of_line(point, line):\n    dx = line[\"x2\"] - line[\"x1\"]\n    dy = line[\"y2\"] - line[\"y1\"]\n    return dx * (point[1] - line[\"y1\"]) - dy * (point[0] - line[\"x1\"])\n\n# ── Process video ─────────────────────────────────────────────────────────────\ncap = cv2.VideoCapture(VIDEO_PATH)\nfps         = cap.get(cv2.CAP_PROP_FPS)\nw           = int(cap.get(cv2.CAP_PROP_FRAME_WIDTH))\nh           = int(cap.get(cv2.CAP_PROP_FRAME_HEIGHT))\ntotal_frames = int(cap.get(cv2.CAP_PROP_FRAME_COUNT))\nout = cv2.VideoWriter(OUTPUT_PATH, cv2.VideoWriter_fourcc(*\"mp4v\"), fps, (w, h))\n\nprint(f\"Video: {w}x{h}  |  {fps:.1f} FPS  |  {total_frames} frames\")\nprint(\"Processing...\\n\")\n\nframe_num = 0\n\nwhile True:\n    ret, frame = cap.read()\n    if not ret:\n        break\n\n    frame_num += 1\n    if frame_num % 200 == 0:\n        pct = (frame_num / total_frames) * 100\n        print(f\"  Frame {frame_num}/{total_frames} ({pct:.1f}%)  IN={count_in}  OUT={count_out}\")\n\n    # ── Detect + Track with ByteTrack ─────────────────────────────────────\n    results = model.track(frame, classes=[0], verbose=False,\n                          persist=True, tracker=\"bytetrack.yaml\",\n                          conf=0.25,        # lower threshold for crowds\n                          iou=0.45)         # handle overlapping people\n\n    if results[0].boxes.id is None:\n        # No tracks this frame — still draw line and counters\n        cv2.line(frame, (LINE[\"x1\"], LINE[\"y1\"]), (LINE[\"x2\"], LINE[\"y2\"]), (0, 80, 255), 2)\n        cv2.putText(frame, f\"IN:  {count_in}\",  (20, 40), cv2.FONT_HERSHEY_SIMPLEX, 1.2, (0, 200, 100), 3)\n        cv2.putText(frame, f\"OUT: {count_out}\", (20, 80), cv2.FONT_HERSHEY_SIMPLEX, 1.2, (0, 80, 255), 3)\n        out.write(frame)\n        continue\n\n    boxes = results[0].boxes.xyxy.cpu().numpy()\n    ids   = results[0].boxes.id.cpu().numpy().astype(int)\n\n    for box, tid in zip(boxes, ids):\n        x1, y1, x2, y2 = map(int, box)\n        cx, cy = (x1 + x2) // 2, y2   # bottom center\n\n        curr_side = side_of_line((cx, cy), LINE)\n\n        if tid not in track_history:\n            track_history[tid] = {\"prev_side\": None, \"cooldown\": 0}\n\n        prev_side = track_history[tid][\"prev_side\"]\n        cooldown  = track_history[tid][\"cooldown\"]\n\n        if cooldown > 0:\n            track_history[tid][\"cooldown\"] -= 1\n\n        elif prev_side is not None and np.sign(prev_side) != np.sign(curr_side):\n            if curr_side > 0:\n                count_in += 1\n                print(f\"  IN  — person {tid}  |  total in={count_in}\")\n                csv_writer.writerow([frame_num, tid, \"IN\", count_in, count_out])\n            else:\n                count_out += 1\n                print(f\"  OUT — person {tid}  |  total out={count_out}\")\n                csv_writer.writerow([frame_num, tid, \"OUT\", count_in, count_out])\n\n            track_history[tid][\"cooldown\"] = 8   # reduced from 15\n\n        track_history[tid][\"prev_side\"] = curr_side\n\n        cv2.rectangle(frame, (x1, y1), (x2, y2), (0, 200, 100), 2)\n        cv2.putText(frame, f\"{tid}\", (x1, y1 - 6),\n                    cv2.FONT_HERSHEY_SIMPLEX, 0.45, (0, 200, 100), 1)\n\n    # Draw line and counters\n    cv2.line(frame, (LINE[\"x1\"], LINE[\"y1\"]), (LINE[\"x2\"], LINE[\"y2\"]), (0, 80, 255), 2)\n    cv2.putText(frame, f\"IN:  {count_in}\",  (20, 40), cv2.FONT_HERSHEY_SIMPLEX, 1.2, (0, 200, 100), 3)\n    cv2.putText(frame, f\"OUT: {count_out}\", (20, 80), cv2.FONT_HERSHEY_SIMPLEX, 1.2, (0, 80, 255), 3)\n\n    out.write(frame)\n\ncap.release()\nout.release()\ncsv_file.close()\n\nprint(f\"\\n{'='*40}\")\nprint(f\"✅ Done!\")\nprint(f\"   Total IN  : {count_in}\")\nprint(f\"   Total OUT : {count_out}\")\nprint(f\"   Net inside: {count_in - count_out}\")\nprint(f\"   Log saved : /kaggle/working/crossings_log.csv\")\nprint(f\"   Video     : {OUTPUT_PATH}\")\nprint(f\"{'='*40}\")","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-05-04T06:52:48.077179Z","iopub.execute_input":"2026-05-04T06:52:48.078301Z","iopub.status.idle":"2026-05-04T06:54:08.896182Z","shell.execute_reply.started":"2026-05-04T06:52:48.078264Z","shell.execute_reply":"2026-05-04T06:54:08.895292Z"}},"outputs":[{"name":"stdout","text":"✅ GPU ready: Tesla T4\n\u001b[KDownloading https://github.com/ultralytics/assets/releases/download/v8.4.0/yolov8s.pt to 'yolov8s.pt': 100% ━━━━━━━━━━━━ 21.5MB 230.3MB/s 0.1s\nVideo: 640x362  |  25.0 FPS  |  5571 frames\nProcessing...\n\n\u001b[31m\u001b[1mrequirements:\u001b[0m Ultralytics requirement ['lap>=0.5.12'] not found, attempting AutoUpdate...\nUsing Python 3.12.12 environment at: /usr\nResolved 2 packages in 195ms\nPrepared 1 package in 69ms\nInstalled 1 package in 3ms\n + lap==0.5.13\n\n\u001b[31m\u001b[1mrequirements:\u001b[0m AutoUpdate success ✅ 0.8s\nWARNING ⚠️ \u001b[31m\u001b[1mrequirements:\u001b[0m \u001b[1mRestart runtime or rerun command for updates to take effect\u001b[0m\n\n  IN  — person 15  |  total in=1\n  IN  — person 16  |  total in=2\n  IN  — person 14  |  total in=3\n  IN  — person 43  |  total in=4\n  IN  — person 70  |  total in=5\n  IN  — person 159  |  total in=6\n  IN  — person 19  |  total in=7\n  IN  —