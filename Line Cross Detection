 = cv2.VideoWriter(OUTPUT_PATH, cv2.VideoWriter_fourcc(*\"mp4v\"), fps, (w, h))\n\nwhile True:\n    ret, frame = cap.read()\n    if not ret:\n        break\n\n    # ── Stage 1: Detect people ─────────────────────────────────────────────\n    results = model(frame, classes=[0], verbose=False)  # class 0 = person\n    detections = []\n    for box in results[0].boxes:\n        x1, y1, x2, y2 = map(int, box.xyxy[0])\n        conf = float(box.conf[0])\n        if conf > 0.4:\n            detections.append(([x1, y1, x2 - x1, y2 - y1], conf, \"person\"))\n\n    # ── Stage 2: Track people across frames ───────────────────────────────\n    tracks = tracker.update_tracks(detections, frame=frame)\n\n    # ── Stage 3: Check for line crossings ─────────────────────────────────\n    for track in tracks:\n        if not track.is_confirmed():\n            continue\n\n        tid = track.track_id\n        x1, y1, x2, y2 = map(int, track.to_ltrb())\n        cx, cy = (x1 + x2) // 2, y2   # use bottom-center of bounding box\n\n        curr_side = side_of_line((cx, cy), LINE)\n\n        if tid in track_history:\n            prev_side = track_history[tid][\"prev_side\"]\n            if prev_side is not None and np.sign(prev_side) != np.sign(curr_side):\n                # Crossing detected! Direction tells us IN vs OUT\n                if curr_side > 0:\n                    count_in += 1\n                    print(f\"  IN  — person {tid}  |  total in={count_in}\")\n                else:\n                    count_out += 1\n                    print(f\"  OUT — person {tid}  |  total out={count_out}\")\n        else:\n            track_history[tid] = {}\n\n        track_history[tid][\"prev_side\"] = curr_side\n\n        # Draw bounding box and ID on frame\n        cv2.rectangle(frame, (x1, y1), (x2, y2), (0, 200, 100), 2)\n        cv2.putText(frame, f\"ID {tid}\", (x1, y1 - 8),\n                    cv2.FONT_HERSHEY_SIMPLEX, 0.55, (0, 200, 100), 2)\n\n    # Draw the boundary line\n    cv2.line(frame, (LINE[\"x1\"], LINE[\"y1\"]), (LINE[\"x2\"], LINE[\"y2\"]),\n             (0, 80, 255), 2)\n\n    # Draw counters on frame\n    cv2.putText(frame, f\"IN:  {count_in}\",  (20, 40),\n                cv2.FONT_HERSHEY_SIMPLEX, 1.2, (0, 200, 100), 3)\n    cv2.putText(frame, f\"OUT: {count_out}\", (20, 80),\n                cv2.FONT_HERSHEY_SIMPLEX, 1.2, (0, 80, 255), 3)\n\n    out.write(frame)\n\ncap.release()\nout.release()\nprint(f\"\\nDone.  IN={count_in}  OUT={count_out}\")\nprint(f\"Output saved to: {OUTPUT_PATH}\")","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-05-04T04:53:38.489167Z","iopub.execute_input":"2026-05-04T04:53:38.490436Z","iopub.status.idle":"2026-05-04T05:04:19.864048Z","shell.execute_reply.started":"2026-05-04T04:53:38.490381Z","shell.execute_reply":"2026-05-04T05:04:19.862953Z"}},"outputs":[{"name":"stdout","text":"  OUT — person 14  |  total out=1\n  OUT — person 14  |  total out=2\n  OUT — person 14  |  total out=3\n  OUT — person 14  |  total out=4\n  OUT — person 45  |  total out=5\n  OUT — person 93  |  total out=6\n  IN  — person 93  |  total in=1\n  OUT — person 175  |  total out=7\n  OUT — person 175  |  total out=8\n  IN  — person 175  |  total in=2\n  OUT — person 175  |  total out=9\n  OUT — person 181  |  total out=10\n  OUT — person 208  |  total out=11\n  OUT — person 208  |  total out=12\n  OUT — person 208  |  total out=13\n  IN  — person 208  |  total in=3\n  OUT — person 208  |  total out=14\n  IN  — person 208  |  total in=4\n  OUT — person 240  |  total out=15\n  IN  — person 240  |  total in=5\n  OUT — person 255  |  total out=16\n  OUT — person 255  |  total out=17\n\nDone.  IN=5  OUT=17\nOutput saved to: /kaggle/working/output2.mp4\n","output_type":"stream"}],"execution_count":18}]}