──────────────────────────────────────────\n\ncap = cv2.VideoCapture(VIDEO_PATH)\nret, frame = cap.read()\ncap.release()\n\nframe_rgb = cv2.cvtColor(frame, cv2.COLOR_BGR2RGB)\n\n# Draw the line and points on the frame so you can see it\nimport numpy as np\npreview = frame_rgb.copy()\ncv2.line(preview, (x1,y1), (x2,y2), (255, 50, 50), 3)\ncv2.circle(preview, (x1,y1), 8, (255, 50, 50), -1)\ncv2.circle(preview, (x2,y2), 8, (255, 50, 50), -1)\n\nplt.figure(figsize=(14, 8))\nplt.imshow(preview)\nplt.title(f\"Line preview:  ({x1},{y1})  →  ({x2},{y2})\")\nplt.xlabel(\"X axis  →\")\nplt.ylabel(\"Y axis  ↓\")\nplt.grid(True, alpha=0.2)\nplt.show()\n\nprint(f'LINE = {{\"x1\": {x1}, \"y1\": {y1}, \"x2\": {x2}, \"y2\": {y2}}}')\nprint(\"If the line looks wrong, adjust x1,y1,x2,y2 and re-run this cell.\")","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-05-04T09:51:33.263025Z","iopub.execute_input":"2026-05-04T09:51:33.263391Z","iopub.status.idle":"2026-05-04T09:51:33.717169Z","shell.execute_reply.started":"2026-05-04T09:51:33.263360Z","shell.execute_reply":"2026-05-04T09:51:33.716137Z"}},"outputs":[{"output_type":"display_data","data":{"text/plain":"<Figure size 1400x800 with 1 Axes>","image/png":"\n"},"metadata":{}},{"name":"stdout","text":"LINE = {\"x1\": 0, \"y1\": 350, \"x2\": 630, \"y2\": 250}\nIf the line looks wrong, adjust x1,y1,x2,y2 and re-run this cell.\n","output_type":"stream"}],"execution_count":15},{"cell_type":"code","source":"\"\"\"\ncrowd_counter_v7.py\n════════════════════════════════════════════════════════════════════\nAdded: Per-person head crossing detection using ByteTrack IDs\n       Each unique person ID that crosses the line is counted once.\n       Bounding boxes drawn with ID labels on screen.\n       \nAll original settings preserved exactly as provided.\n\"\"\"\n\nimport cv2\nimport numpy as np\nimport torch\nimport csv\nfrom ultralytics import YOLO\nfrom collections import defaultdict\n\nDEVICE = \"cuda\" if torch.cuda.is_available() else \"cpu\"\nprint(f\"{'✅ GPU' if DEVICE == 'cuda' else '⚠️  CPU'}: \"\n      f\"{torch.cuda.get_device_name(0) if DEVICE == 'cuda' else 'running on CPU'}\")\n\n# ══════════════════════════════════════════════════════════════\n#  CONFIGURATION — unchanged from your version\n# ══════════════════════════════════════════════════════════════\n\nLINE = {\"x1\": 0, \"y1\": 350, \"x2\": 630, \"y2\": 250}\n\nVIDEO_PATH  = \"/kaggle/input/datasets/nahidsarkar/newwalking/WhatsApp Video 2026-04-05 at 9.15.53 AM.mp4\"\nOUTPUT_PATH = \"/kaggle/working/newwalking20.mp4\"\nCSV_PATH    = \"/kaggle/working/crossings_log20.csv\"\n\nFLUX_CALIB_K     = 31.0\nCALIBRATION_MODE = False\n\nSEED_STRIP_PX = 160\n\nMAX_FEATURES  = 3000\nMIN_FEATURES  = 600\nRESEED_EVERY  = 15\nQUALITY_LEVEL = 0.005\nMIN_DISTANCE  = 4\nOF_WIN_SIZE   = (21, 21)\nOF_MAX_LEVEL  = 3\n\n# ── Head counter settings ──────────────────────────────────────\nHEAD_CONF        = 0.20        # YOLO detection confidence threshold\nHEAD_COOLDOWN    = 8          # frames before same ID can cross again\nSHOW_BOXES       = True        # draw bounding boxes on output video\nSHOW_IDS         = True        # show track ID labels\nBOX_COLOR_IN     = (0, 220, 80)    # green  — person counted as IN\nBOX_COLOR_OUT    = (0, 60, 220)    # blue   — person counted as OUT\nBOX_COLOR_ACTIVE = (255, 200, 0)   # yellow — person near line, not yet crossed\nBOX_COLOR_OTHER  = (180, 180, 180) # gray   — person far from line\n\n# ══════════════════════════════════════════════════════════════\nmodel = YOLO(\"rtdetr-l.pt\")   # transformer-based, much better in crowds\nmodel.to(DEVICE)\n\n\n# ─────────────────────────────────────────────────────────────\n#  Geometry\n# ─────────────────────────────────────────────────────────────\n\ndef _line_coeffs(line):\n    x1, y1 = line[\"x1\"], line[\"y1\"]\n    x2, y2 = line[\"x2\"], line[\"y2\"]\n    A =  float(y2 - y1)\n    B = -float(x2 - x1)\n    C =  float((x2 - x1) * y1 - (y2 - y1) * x1)\n    return A, B, C\n\n_COEFFS = _line_coeffs(LINE)\n\ndef side_vec(xs, ys):\n    A, B, C = _COEFFS\n    return A * xs + B * ys + C\n\ndef dist_to_line_vec(xs, ys):\n    A, B, C = _COEFFS\n    return np.abs(A * xs + B * ys + C) / (np.sqrt(A*A + B*B) + 1e-9)\n\ndef side_scalar(px, py):\n    A, B, C = _COEFFS\n    return float(A * px + B * py + C)\n\n\n# ─────────────────────────────────────────────────────────────\n#  Strip mask\n# ─────────────────────────────────────────────────────────────\n\n_strip_mask = None\n\ndef make_strip_mask(shape, strip_px):\n    H, W = shape\n    ys, xs = np.mgrid[0:H, 0:W].astype(np.float32)\n    dists = dist_to_line_vec(xs, ys)\n    return (dists < strip_px).astype(np.uint8) * 255\n\ndef seed_features(gray, strip_px):\n    global _strip_mask\n    if _strip_mask is None or _strip_mask.shape != gray.shape:\n        _strip_mask = make_strip_mask(gray.shape, strip_px)\n    return cv2.goodFeaturesToTrack(\n        gray, mask=_strip_mask,\n        maxCorners=MAX_FEATURES,\n        qualityLevel=QUALITY_LEVEL,\n        minDistance=MIN_DISTANCE,\n        blockSize=7,\n    )\n\n_lk_params = dict(\n    winSize=OF_WIN_SIZE,\n    maxLevel=OF_MAX_LEVEL,\n    criteria=(cv2.TERM_CRITERIA_EPS | cv2.TERM_CRITERIA_COUNT, 15, 0.03),\n)\n\n\n# ─────────────────────────────────────────────────────────────\n#  Flux counter (optical flow based — unchanged logic)\n# ─────────────────────────────────────────────────────────────\n\nclass FluxCounter:\n    def __init__(self, k=FLUX_CALIB_K):\n        self.k          = k\n        self.events_in  = 0.0\n        self.events_out = 0.0\n\n    @property\n    def count_in(self):\n        return int(self.events_in / max(self.k, 0.1))\n\n    @property\n    def count_out(self):\n        return int(self.events_out / max(self.k, 0.1))\n\n    def update(self, prev_pts, next_pts, status):\n        ok = status.flatten() == 1\n        if ok.sum() == 0:\n            return\n        p0 = prev_pts[ok].reshape(-1, 2)\n        p1 = next_pts[ok].reshape(-1, 2)\n\n        d0 = dist_to_line_vec(p0[:, 0], p0[:, 1])\n        d1 = dist_to_line_vec(p1[:, 0], p1[:, 1])\n        near = (d0 < SEED_STRIP_PX) | (d1 < SEED_STRIP_PX)\n\n        p0n, p1n = p0[near], p1[near]\n        if len(p0n) == 0:\n            return\n\n        s0 = side_vec(p0n[:, 0], p0n[:, 1])\n        s1 = side_vec(p1n[:, 0], p1n[:, 1])\n\n        self.events_in  += ((s0 > 0) & (s1 <= 0)).sum()\n        self.events_out += ((s0 <= 0) & (s1 > 0)).sum()\n\n\n# ─────────────────────────────────────────────────────────────\n#  Head / Person tracker — exact ID-based crossing counter\n# ─────────────────────────────────────────────────────────────\n\nclass HeadCounter:\n    \"\"\"\n    Uses ByteTrack IDs from YOLO to count each unique person\n    exactly once as they cross the counting line.\n    \n    track_state[tid] = {\n        'prev_side' : last known side (+1 or -1),\n        'cooldown'  : frames remaining before re-cross allowed,\n        'status'    : 'in' | 'out' | 'active' | 'other'\n        'box'       : last bounding box (x1,y1,x2,y2)\n    }\n    \"\"\"\n    def __init__(self):\n        self.track_state = {}\n        self.counted_in  = set()   # track IDs confirmed as IN\n        self.counted_out = set()   # track IDs confirmed as OUT\n        self.count_in    = 0\n        self.count_out   = 0\n\n    def update(self, results, frame_num, csv_writer):\n        if results[0].boxes is None or results[0].boxes.id is None:\n            return\n\n        boxes = results[0].boxes.xyxy.cpu().numpy()\n        ids   = results[0].boxes.id.cpu().numpy().astype(int)\n\n        for box, tid in zip(boxes, ids):\n            x1, y1, x2, y2 = map(int, box)\n            # Use center-bottom of box as foot point,\n            # and center-top as head point — we check head crossing\n\n            cx = (x1 + x2) // 2\n            cy = y1 + (y2 - y1) // 3   # upper third — chest/head level, more visible in crowds\n            head_y = y1             # top of bounding box = head\n\n            curr_side = np.sign(side_scalar(cx, cy))\n            dist      = dist_to_line_vec(\n                np.array([float(cx)]), np.array([float(cy)]))[0]\n            near_line = dist < SEED_STRIP_PX * 2\n\n            if tid not in self.track_state:\n                self.track_state[tid] = {\n                    'prev_side': curr_side,\n                    'cooldown' : 0,\n                    'status'   : 'active' if near_line else 'other',\n                    'box'      : (x1, y1, x2, y2),\n                }\n                continue\n\n            rec = self.track_state[tid]\n            rec['box'] = (x1, y1, x2, y2)\n\n            # Cooldown — prevent double-counting same person\n            if rec['cooldown'] > 0:\n                rec['cooldown'] -= 1\n                rec['prev_side'] = curr_side\n                continue\n\n            prev = rec['prev_side']\n\n            # Crossing detected: sign flipped\n            if prev != 0 and curr_side != 0 and prev != curr_side:\n                # LEFT → RIGHT = positive→negative = IN\n                if prev > 0 and curr_side < 0:\n                    self.count_in += 1\n                    self.counted_in.add(tid)\n                    rec['status']   = 'in'\n                    rec['cooldown'] = HEAD_COOLDOWN\n                    csv_writer.writerow(\n                        [frame_num, int(tid), \"HEAD_IN\",\n                         self.count_in, self.count_out])\n                elif prev < 0 and curr_side > 0:\n                    self.count_out += 1\n                    self.counted_out.add(tid)\n                    rec['status']   = 'out'\n                    rec['cooldown'] = HEAD_COOLDOWN\n                    csv_writer.writerow(\n                        [frame_num, int(tid), \"HEAD_OUT\",\n                         self.count_in, self.count_out])\n            else:\n                if near_line:\n                    rec['status'] = 'active'\n                elif tid not in self.counted_in and tid not in self.counted_out:\n                    rec['status'] = 'other'\n\n            rec['prev_side'] = curr_side\n\n    def draw(self, frame):\n        if not SHOW_BOXES:\n            return frame\n\n        for tid, rec in self.track_state.items():\n            x1, y1, x2, y2 = rec['box']\n            status = rec['status']\n\n            if status == 'in':\n                color = BOX_COLOR_IN\n            elif status == 'out':\n                color = BOX_COLOR_OUT\n            elif status == 'active':\n                color = BOX_COLOR_ACTIVE\n            else:\n                color = BOX_COLOR_OTHER\n\n            # Bounding box\n            cv2.rectangle(frame, (x1, y1), (x2, y2), color, 2)\n\n            # ID label above the box\n            if SHOW_IDS:\n                label = f\"#{tid}\"\n                if status == 'in':\n                    label += \" IN\"\n                elif status == 'out':\n                    label += \" OUT\"\n                lx = max(x1, 0)\n                ly = max(y1 - 8, 12)\n                cv2.putText(frame, label, (lx, ly),\n                            cv2.FONT_HERSHEY_SIMPLEX, 0.45, color, 1)\n\n            # Small dot at head position (top center of box)\n            head_x = (x1 + x2) // 2\n            cv2.circle(frame, (head_x, y1), 4, color, -1)\n\n        return frame\n\n\n# ─────────────────────────────────────────────────────────────\n#  Drawing — FIXED: no flow dots, boxes only near line\n# ─────────────────────────────────────────────────────────────\n\ndef draw_overlay(frame, flux, head):\n    H, W = frame.shape[:2]\n\n    # Clamp line coords to frame\n    lx1 = max(0, min(W - 1, LINE[\"x1\"]))\n    ly1 = max(0, min(H - 1, LINE[\"y1\"]))\n    lx2 = max(0, min(W - 1, LINE[\"x2\"]))\n    ly2 = max(0, min(H - 1, LINE[\"y2\"]))\n\n    # Counting line\n    cv2.line(frame, (lx1, ly1), (lx2, ly2), (0, 60, 220), 2)\n\n    # Strip guide lines (subtle dashed look via shorter lines)\n    cv2.line(frame, (lx1, max(0, ly1 - 30)), (lx2, max(0, ly2 - 30)),\n             (0, 60, 220), 1)\n    cv2.line(frame, (lx1, min(H-1, ly1 + 30)), (lx2, min(H-1, ly2 + 30)),\n             (0, 60, 220), 1)\n\n    # IN direction arrow at midpoint\n    mx = (lx1 + lx2) // 2\n    my = (ly1 + ly2) // 2\n    cv2.arrowedLine(frame, (mx - 40, my + 5), (mx + 40, my - 5),\n                    (0, 220, 80), 2, tipLength=0.3)\n    cv2.putText(frame, \"IN\", (mx + 44, my),\n                cv2.FONT_HERSHEY_SIMPLEX, 0.5, (0, 220, 80), 1)\n\n    # Counter panel — solid black background, clean text\n    cv2.rectangle(frame, (5, 5), (300, 110), (0, 0, 0), -1)\n    cv2.rectangle(frame, (5, 5), (300, 110), (80, 80, 80), 1)\n\n    cv2.putText(frame, f\"FLUX  IN:  {flux.count_in}\",\n                (12, 35), cv2.FONT_HERSHEY_SIMPLEX, 0.85, (0, 220, 100), 2)\n    cv2.putText(frame, f\"FLUX  OUT: {flux.count_out}\",\n                (12, 65), cv2.FONT_HERSHEY_SIMPLEX, 0.85, (0, 100, 220), 2)\n    cv2.putText(frame, f\"HEAD IN:{head.count_in}  OUT:{head.count_out}\",\n                (12, 95), cv2.FONT_HERSHEY_SIMPLEX, 0.6, (200, 200, 200), 1)\n\n    # ── NO flow_pts dots — removed entirely ──────────────────\n    return frame\n\n\nclass HeadCounter:\n    def __init__(self):\n        self.track_state = {}\n        self.counted_in  = set()\n        self.counted_out = set()\n        self.count_in    = 0\n        self.count_out   = 0\n\n    def update(self, results, frame_num, csv_writer):\n        # ── Mark all existing tracks as not-seen this frame ──\n        for rec in self.track_state.values():\n            rec['seen_this_frame'] = False\n\n        if results[0].boxes is not None and results[0].boxes.id is not None:\n            boxes = results[0].boxes.xyxy.cpu().numpy()\n            ids   = results[0].boxes.id.cpu().numpy().astype(int)\n\n            for box, tid in zip(boxes, ids):\n                x1, y1, x2, y2 = map(int, box)\n                cx = (x1 + x2) // 2\n                cy = (y1 + y2) // 2\n\n                curr_side = np.sign(side_scalar(cx, cy))\n                dist      = dist_to_line_vec(\n                    np.array([float(cx)]), np.array([float(cy)]))[0]\n                near_line = dist < SEED_STRIP_PX * 2\n\n                if tid not in self.track_state:\n                    self.track_state[tid] = {\n                        'prev_side'       : curr_side,\n                        'cooldown'        : 0,\n                        'status'          : 'active' if near_line else 'other',\n                        'box'             : (x1, y1, x2, y2),\n                        'seen_this_frame' : True,\n                        'lost_frames'     : 0,\n                    }\n                    continue\n\n                rec = self.track_state[tid]\n                rec['box']              = (x1, y1, x2, y2)\n                rec['seen_this_frame']  = True\n                rec['lost_frames']      = 0   # reset lost counter\n\n                if rec['cooldown'] > 0:\n                    rec['cooldown'] -= 1\n                    rec['prev_side'] = curr_side\n                    continue\n\n                prev = rec['prev_side']\n                if prev != 0 and curr_side != 0 and prev != curr_side:\n                    if prev > 0 and curr_side < 0:\n                        self.count_in += 1\n                        self.counted_in.add(tid)\n                        rec['status']   = 'in'\n                        rec['cooldown'] = HEAD_COOLDOWN\n                        csv_writer.writerow(\n                            [frame_num, int(tid), \"HEAD_IN\",\n                             self.count_in, self.count_out])\n                    elif prev < 0 and curr_side > 0:\n                        self.count_out += 1\n                        self.counted_out.add(tid)\n                        rec['status']   = 'out'\n                        rec['cooldown'] = HEAD_COOLDOWN\n                        csv_writer.writerow(\n                            [frame_num, int(tid), \"HEAD_OUT\",\n                             self.count_in, self.count_out])\n                else:\n                    rec['status'] = 'active' if near_line else 'other'\n\n                rec['prev_side'] = curr_side\n\n        # ── Increment lost counter for unseen tracks ──────────\n        # Remove tracks that have been missing for more than 10 frames\n        MAX_LOST_FRAMES = 10\n        to_delete = []\n        for tid, rec in self.track_state.items():\n            if not rec['seen_this_frame']:\n                rec['lost_frames'] = rec.get('lost_frames', 0) + 1\n                if rec['lost_frames'] > MAX_LOST_FRAMES:\n                    to_delete.append(tid)\n\n        for tid in to_delete:\n            del self.track_state[tid]\n\n    def draw(self, frame):\n        if not SHOW_BOXES:\n            return frame\n\n        for tid, rec in self.track_state.items():\n            status = rec['status']\n\n            # Skip far-away people and already-removed tracks\n            if status == 'other':\n                continue\n\n            # Only draw if seen in recent frames (lost_frames == 0)\n            # This prevents ghost boxes from staying on screen\n            if rec.get('lost_frames', 0) > 0:\n                continue\n\n            x1, y1, x2, y2 = rec['box']\n\n            if status == 'in':\n                color = BOX_COLOR_IN\n            elif status == 'out':\n                color = BOX_COLOR_OUT\n            else:\n                color = BOX_COLOR_ACTIVE\n\n            cv2.rectangle(frame, (x1, y1), (x2, y2), color, 1)\n\n            if SHOW_IDS and status in ('in', 'out'):\n                label = f\"#{tid} {'IN' if status == 'in' else 'OUT'}\"\n                lx = max(x1, 0)\n                ly = max(y1 - 5, 12)\n                cv2.putText(frame, label, (lx, ly),\n                            cv2.FONT_HERSHEY_SIMPLEX, 0.4, color, 1)\n\n            head_x = (x1 + x2) // 2\n            cv2.circle(frame, (head_x, y1), 3, color, -1)\n\n        return frame\n        \n# ══════════════════════════════════════════════════════════════\n#  MAIN\n# ══════════════════════════════════════════════════════════════\n\ndef main():\n    global _COEFFS\n\n    cap          = cv2.VideoCapture(VIDEO_PATH)\n    fps          = cap.get(cv2.CAP_PROP_FPS)\n    W            = int(cap.get(cv2.CAP_PROP_FRAME_WIDTH))\n    H            = int(cap.get(cv2.CAP_PROP_FRAME_HEIGHT))\n    total_frames = int(cap.get(cv2.CAP_PROP_FRAME_COUNT))\n\n    _COEFFS = _line_coeffs(LINE)\n\n    # Warn if line is outside frame bounds\n    if (LINE[\"x1\"] > W or LINE[\"x2\"] > W or\n            LINE[\"y1\"] > H or LINE[\"y2\"] > H):\n        print(f\"⚠️  WARNING: Line coords ({LINE['x1']},{LINE['y1']}) → \"\n              f\"({LINE['x2']},{LINE['y2']}) exceed frame size {W}×{H}.\")\n        print(f\"   The line will still be used for geometry but won't be \"\n              f\"visible in the output video.\")\n        print(f\"   If counts are 0, update LINE to coordinates within \"\n              f\"0–{W} (x) and 0–{H} (y).\\n\")\n\n    out = cv2.VideoWriter(\n        OUTPUT_PATH, cv2.VideoWriter_fourcc(*\"mp4v\"), fps, (W, H))\n\n    print(f\"Video  : {W}×{H}  |  {fps:.1f} fps  |  {total_frames} frames\")\n    print(f\"Line   : ({LINE['x1']},{LINE['y1']}) → ({LINE['x2']},{LINE['y2']})\")\n    print(f\"Coeffs : A={_COEFFS[0]:.2f}  B={_COEFFS[1]:.2f}  C={_COEFFS[2]:.2f}\")\n    print(f\"Strip  : ±{SEED_STRIP_PX} px from line\")\n    print(f\"k      : {FLUX_CALIB_K}\\n\")\n\n    # Direction check\n    test_left  = side_scalar(10, 300)\n    test_right = side_scalar(610, 260)\n    print(f\"Side check LEFT  (10,300)  = {test_left:.0f}  \"\n          f\"→ {'✅ positive ✓' if test_left > 0 else '❌ swap IN/OUT!'}\")\n    print(f\"Side check RIGHT (610,260) = {test_right:.0f} \"\n          f\"→ {'✅ negative ✓' if test_right < 0 else '❌ swap IN/OUT!'}\\n\")\n\n    if CALIBRATION_MODE:\n        print(\"⚠️  CALIBRATION MODE — note raw_events_