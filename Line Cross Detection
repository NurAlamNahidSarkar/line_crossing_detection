rue,"execution":{"iopub.status.busy":"2026-05-05T13:16:49.955259Z","iopub.execute_input":"2026-05-05T13:16:49.955878Z","iopub.status.idle":"2026-05-05T13:16:50.605730Z","shell.execute_reply.started":"2026-05-05T13:16:49.955813Z","shell.execute_reply":"2026-05-05T13:16:50.604727Z"}},"outputs":[{"output_type":"display_data","data":{"text/plain":"<Figure size 1600x900 with 1 Axes>","image/png":"\n"},"metadata":{}},{"name":"stdout","text":"LINE = {\"x1\": 0, \"y1\": 280, \"x2\": 630, \"y2\": 270}\nCopy this directly into your detector code.\n","output_type":"stream"}],"execution_count":59},{"cell_type":"code","source":"\"\"\"\ncrowd_counter_v10.py\n════════════════════════════════════════════════════════════════════\nFixed: Simplified crossing detection\n  - Removed stable_frames (was blocking counts for first N frames)\n  - Removed side_history + history_agrees (was too strict)\n  - Kept cooldown (prevents double counting)\n  - LEFT → RIGHT = OUT\n  - RIGHT → LEFT = IN\n\"\"\"\n\nimport cv2\nimport numpy as np\nimport torch\nimport csv\nimport time\nfrom ultralytics import YOLO\nfrom collections import defaultdict\n\nDEVICE = \"cuda\" if torch.cuda.is_available() else \"cpu\"\nprint(f\"{'✅ GPU' if DEVICE == 'cuda' else '⚠️  CPU'}: \"\n      f\"{torch.cuda.get_device_name(0) if DEVICE == 'cuda' else 'running on CPU'}\")\n\n# ══════════════════════════════════════════════════════════════\n#  CONFIGURATION\n# ══════════════════════════════════════════════════════════════\n\nLINE = {\"x1\": 0, \"y1\": 280, \"x2\": 630, \"y2\": 270}\n\nVIDEO_PATH  = \"/kaggle/input/datasets/nahidsarkar/massive-person-walking/WhatsApp Video 2026-04-05 at 9.15.53 AM.mp4\"\nOUTPUT_PATH = \"/kaggle/working/massive.mp4\"\nCSV_PATH    = \"/kaggle/working/massive.csv\"\n\nFLUX_CALIB_K     = 6.5\nCALIBRATION_MODE = True\n\nSEED_STRIP_PX = 160\n\nMAX_FEATURES  = 3000\nMIN_FEATURES  = 600\nRESEED_EVERY  = 15\nQUALITY_LEVEL = 0.005\nMIN_DISTANCE  = 4\nOF_WIN_SIZE   = (21, 21)\nOF_MAX_LEVEL  = 3\n\n# ── Head counter settings ──────────────────────────────────────\nHEAD_CONF        = 0.20\nHEAD_COOLDOWN    = 8\nSHOW_BOXES       = True\nSHOW_IDS         = True\nBOX_COLOR_IN     = (0, 220, 80)\nBOX_COLOR_OUT    = (0, 60, 220)\nBOX_COLOR_ACTIVE = (255, 200, 0)\nBOX_COLOR_OTHER  = (180, 180, 180)\n\n# ══════════════════════════════════════════════════════════════\nmodel = YOLO(\"yolo26x.pt\")\nmodel.to(DEVICE)\n\n\n# ─────────────────────────────────────────────────────────────\n#  Geometry\n# ─────────────────────────────────────────────────────────────\n\ndef _line_coeffs(line):\n    x1, y1 = line[\"x1\"], line[\"y1\"]\n    x2, y2 = line[\"x2\"], line[\"y2\"]\n    A =  float(y2 - y1)\n    B = -float(x2 - x1)\n    C =  float((x2 - x1) * y1 - (y2 - y1) * x1)\n    return A, B, C\n\n_COEFFS = _line_coeffs(LINE)\n\ndef side_vec(xs, ys):\n    A, B, C = _COEFFS\n    return A * xs + B * ys + C\n\ndef dist_to_line_vec(xs, ys):\n    A, B, C = _COEFFS\n    return np.abs(A * xs + B * ys + C) / (np.sqrt(A*A + B*B) + 1e-9)\n\ndef side_scalar(px, py):\n    A, B, C = _COEFFS\n    return float(A * px + B * py + C)\n\n\n# ─────────────────────────────────────────────────────────────\n#  Strip mask\n# ─────────────────────────────────────────────────────────────\n\n_strip_mask = None\n\ndef make_strip_mask(shape, strip_px):\n    H, W = shape\n    ys, xs = np.mgrid[0:H, 0:W].astype(np.float32)\n    dists = dist_to_line_vec(xs, ys)\n    return (dists < strip_px).astype(np.uint8) * 255\n\ndef seed_features(gray, strip_px):\n    global _strip_mask\n    if _strip_mask is None or _strip_mask.shape != gray.shape:\n        _strip_mask = make_strip_mask(gray.shape, strip_px)\n    return cv2.goodFeaturesToTrack(\n        gray, mask=_strip_mask,\n        maxCorners=MAX_FEATURES,\n        qualityLevel=QUALITY_LEVEL,\n        minDistance=MIN_DISTANCE,\n        blockSize=7,\n    )\n\n_lk_params = dict(\n    winSize=OF_WIN_SIZE,\n    maxLevel=OF_MAX_LEVEL,\n    criteria=(cv2.TERM_CRITERIA_EPS | cv2.TERM_CRITERIA_COUNT, 15, 0.03),\n)\n\n\n# ─────────────────────────────────────────────────────────────\n#  Flux counter\n# ─────────────────────────────────────────────────────────────\n\nclass FluxCounter:\n    def __init__(self, k=FLUX_CALIB_K):\n        self.k          = k\n        self.events_in  = 0.0\n        self.events_out = 0.0\n\n    @property\n    def count_in(self):\n        return int(self.events_in / max(self.k, 0.1))\n\n    @property\n    def count_out(self):\n        return int(self.events_out / max(self.k, 0.1))\n\n    def update(self, prev_pts, next_pts, status):\n        ok = status.flatten() == 1\n        if ok.sum() == 0:\n            return\n        p0 = prev_pts[ok].reshape(-1, 2)\n        p1 = next_pts[ok].reshape(-1, 2)\n\n        d0 = dist_to_line_vec(p0[:, 0], p0[:, 1])\n        d1 = dist_to_line_vec(p1[:, 0], p1[:, 1])\n        near = (d0 < SEED_STRIP_PX) | (d1 < SEED_STRIP_PX)\n\n        p0n, p1n = p0[near], p1[near]\n        if len(p0n) == 0:\n            return\n\n        s0 = side_vec(p0n[:, 0], p0n[:, 1])\n        s1 = side_vec(p1n[:, 0], p1n[:, 1])\n\n        # LEFT→RIGHT = OUT (negative→positive)\n        # RIGHT→LEFT = IN  (positive→negative)\n        self.events_out += ((s0 <= 0) & (s1 > 0)).sum()\n        self.events_in  += ((s0 > 0) & (s1 <= 0)).sum()\n\n\n# ─────────────────────────────────────────────────────────────\n#  Head counter\n# ─────────────────────────────────────────────────────────────\n\nclass HeadCounter:\n    def __init__(self):\n        self.track_state = {}\n        self.counted_in  = set()\n        self.counted_out = set()\n        self.count_in    = 0\n        self.count_out   = 0\n\n    def update(self, results, frame_num, csv_writer):\n        for rec in self.track_state.values():\n            rec['seen_this_frame'] = False\n\n        if results[0].boxes is not None and results[0].boxes.id is not None:\n            boxes = results[0].boxes.xyxy.cpu().numpy()\n            ids   = results[0].boxes.id.cpu().numpy().astype(int)\n\n            for box, tid in zip(boxes, ids):\n                x1, y1, x2, y2 = map(int, box)\n                cx = (x1 + x2) // 2\n                cy = y1 + (y2 - y1) // 4\n\n                curr_side = np.sign(side_scalar(cx, cy))\n                dist      = dist_to_line_vec(\n                    np.array([float(cx)]), np.array([float(cy)]))[0]\n                near_line = dist < 150\n\n                # ── New track: just record side, don't count yet ──\n                if tid not in self.track_state:\n                    self.track_state[tid] = {\n                        'prev_side'       : curr_side,\n                        'cooldown'        : 0,\n                        'status'          : 'active' if near_line else 'other',\n                        'box'             : (x1, y1, x2, y2),\n                        'seen_this_frame' : True,\n                        'lost_frames'     : 0,\n                    }\n                    continue\n\n                rec = self.track_state[tid]\n                rec['box']             = (x1, y1, x2, y2)\n                rec['seen_this_frame'] = True\n                rec['lost_frames']     = 0\n\n                # ── Cooldown: skip counting but keep updating side ─\n                if rec['cooldown'] > 0:\n                    rec['cooldown'] -= 1\n                    rec['prev_side'] = curr_side\n                    continue\n\n                prev = rec['prev_side']\n\n                # ── Crossing detected ─────────────────────────────\n                # prev != curr_side means person just crossed the line\n                if prev != 0 and curr_side != 0 and prev != curr_side:\n\n                    if curr_side > 0:\n                        # LEFT → RIGHT = OUT\n                        self.count_out += 1\n                        self.counted_out.add(tid)\n                        rec['status']   = 'out'\n                        rec['cooldown'] = HEAD_COOLDOWN\n                        csv_writer.writerow(\n                            [frame_num, int(tid), \"HEAD_OUT\",\n                             self.count_in, self.count_out])\n\n                    elif curr_side < 0:\n                        # RIGHT → LEFT = IN\n                        self.count_in += 1\n                        self.counted_in.add(tid)\n                        rec['status']   = 'in'\n                        rec['cooldown'] = HEAD_COOLDOWN\n                        csv_writer.writerow(\n                            [frame_num, int(tid), \"HEAD_IN\",\n                             self.count_in, self.count_out])\n                else:\n                    rec['status'] = 'active' if near_line else 'other'\n\n                rec['prev_side'] = curr_side\n\n        MAX_LOST_FRAMES = 10\n        to_delete = []\n        for tid, rec in self.track_state.items():\n            if not rec['seen_this_frame']:\n                rec['lost_frames'] = rec.get('lost_frames', 0) + 1\n                if rec['lost_frames'] > MAX_LOST_FRAMES:\n                    to_delete.append(tid)\n        for tid in to_delete:\n            del self.track_state[tid]\n\n    def draw(self, frame):\n        if not SHOW_BOXES:\n            return frame\n\n        for tid, rec in self.track_state.items():\n            status = rec['status']\n            if status == 'other':\n                continue\n            if rec.get('lost_frames', 0) > 0:\n                continue\n\n            x1, y1, x2, y2 = rec['box']\n\n            if status == 'in':\n                color = BOX_COLOR_IN\n            elif status == 'out':\n                color = BOX_COLOR_OUT\n            else:\n                color = BOX_COLOR_ACTIVE\n\n            cv2.rectangle(frame, (x1, y1), (x2, y2), color, 1)\n\n            if SHOW_IDS and status in ('in', 'out'):\n                label = f\"#{tid} {'IN' if status == 'in' else 'OUT'}\"\n                lx = max(x1, 0)\n                ly = max(y1 - 5, 12)\n                cv2.putText(frame, label, (lx, ly),\n                            cv2.FONT_HERSHEY_SIMPLEX, 0.4, color, 1)\n\n            head_x = (x1 + x2) // 2\n            cv2.circle(frame, (head_x, y1), 3, color, -1)\n\n        return frame\n\n\n# ─────────────────────────────────────────────────────────────\n#  Drawing\n# ─────────────────────────────────────────────────────────────\n\ndef draw_overlay(frame, flux, head):\n    H, W = frame.shape[:2]\n\n    lx1 = max(0, min(W - 1, LINE[\"x1\"]))\n    ly1 = max(0, min(H - 1, LINE[\"y1\"]))\n    lx2 = max(0, min(W - 1, LINE[\"x2\"]))\n    ly2 = max(0, min(H - 1, LINE[\"y2\"]))\n\n    cv2.line(frame, (lx1, ly1), (lx2, ly2), (0, 60, 220), 2)\n    cv2.line(frame, (lx1, max(0, ly1 - 30)), (lx2, max(0, ly2 - 30)),\n             (0, 60, 220), 1)\n    cv2.line(frame, (lx1, min(H-1, ly1 + 30)), (lx2, min(H-1, ly2 + 30)),\n             (0, 60, 220), 1)\n\n    mx = (lx1 + lx2) // 2\n    my = (ly1 + ly2) // 2\n    cv2.arrowedLine(frame, (mx + 40, my + 5), (mx - 40, my - 5),\n                    (0, 220, 80), 2, tipLength=0.3)\n    cv2.putText(frame, \"IN\", (mx - 60, my),\n                cv2.FONT_HERSHEY_SIMPLEX, 0.5, (0, 220, 80), 1)\n\n    cv2.rectangle(frame, (5, 5), (300, 110), (0, 0, 0), -1)\n    cv2.rectangle(frame, (5, 5), (300, 110), (80, 80, 80), 1)\n\n    cv2.putText(frame, f\"FLUX  IN:  {flux.count_in}\",\n                (12, 35), cv2.FONT_HERSHEY_SIMPLEX, 0.85, (0, 220, 100), 2)\n    cv2.putText(frame, f\"FLUX  OUT: {flux.count_out}\",\n                (12, 65), cv2.FONT_HERSHEY_SIMPLEX, 0.85, (0, 100, 220), 2)\n    cv2.putText(frame, f\"HEAD IN:{head.count_in}  OUT:{head.count_out}\",\n                (12, 95), cv2.FONT_HERSHEY_SIMPLEX, 0.6, (200, 200, 200), 1)\n\n    return frame\n\n\n# ══════════════════════════════════════════════════════════════\n#  MAIN\n# ══════════════════════════════════════════════════════════════\n\ndef main():\n    global _COEFFS\n\n    start_time = time.time()\n\n    cap          = cv2.VideoCapture(VIDEO_PATH)\n    fps          = cap.get(cv2.CAP_PROP_FPS)\n    W            = int(cap.get(cv2.CAP_PROP_FRAME_WIDTH))\n    H            = int(cap.get(cv2.CAP_PROP_FRAME_HEIGHT))\n    total_frames = int(cap.get(cv2.CAP_PROP_FRAME_COUNT))\n\n    _COEFFS = _line_coeffs(LINE)\n\n    if (LINE[\"x1\"] > W or LINE[\"x2\"] > W or\n            LINE[\"y1\"] > H or LINE[\"y2\"] > H):\n        print(f\"⚠️  WARNING: Line coords exceed frame size {W}×{H}.\")\n        print(f\"   Update LINE to coordinates within 0–{W} (x) and 0–{H} (y).\\n\")\n\n    out = cv2.VideoWriter(\n        OUTPUT_PATH, cv2.VideoWriter_fourcc(*\"mp4v\"), fps, (W, H))\n\n    print(f\"Video    : {W}×{H}  |  {fps:.1f} fps  |  {total_frames} frames\")\n    print(f\"Duration : {total_frames / fps:.1f} seconds  \"\n          f\"({total_frames / fps / 60:.1f} minutes)\")\n    print(f\"Line     : ({LINE['x1']},{LINE['y1']}) → ({LINE['x2']},{LINE['y2']})\")\n    print(f\"Coeffs   : A={_COEFFS[0]:.2f}  B={_COEFFS[1]:.2f}  C={_COEFFS[2]:.2f}\")\n    print(f\"Strip    : ±{SEED_STRIP_PX} px from line\")\n    print(f\"k        : {FLUX_CALIB_K}\")\n    print(f\"Logic    : LEFT→RIGHT = OUT  |  RIGHT→LEFT = IN\\n\")\n\n    if CALIBRATION_MODE:\n        print(\"⚠️  CALIBRATION MODE — note raw_events_in at end\\n\")\n\n    csv_file   = open(CSV_PATH, \"w\", newline=\"\")\n    csv_writer = csv.writer(csv_file)\n    csv_writer.writerow(\n        [\"frame\", \"track_id\", \"event\", \"head_in_total\", \"head_out_total\"])\n\n    flux        = FluxCounter()\n    head        = HeadCounter()\n    prev_gray   = None\n    feature_pts = None\n    frame_num   = 0\n\n    while True:\n        ret, frame = cap.read()\n        if not ret:\n            break\n\n        frame_num += 1\n        gray = cv2.cvtColor(frame, cv2.COLOR_BGR2GRAY)\n\n        results = model.track(\n            frame, classes=[0], verbose=False,\n            persist=True, tracker=\"bytetrack.yaml\",\n            conf=0.15,        # CHANGE: Lowered from 0.30 to catch hidden people\n            iou=0.65,         # CHANGE: Increased from 0.45 to allow overlapping boxes\n            max_det=1500      # CHANGE: Increased from 300 to allow massive crowds in one frame\n        )\n\n        head.update(results, frame_num, csv_writer)\n\n        if frame_num % RESEED_EVERY == 0 or feature_pts is None:\n            new_pts = seed_features(gray, SEED_STRIP_PX)\n            if new_pts is not None:\n                if feature_pts is not None and len(feature_pts) > 0:\n                    combined    = np.vstack([feature_pts, new_pts])\n                    feature_pts = combined[:MAX_FEATURES]\n                else:\n                    feature_pts = new_pts\n        elif feature_pts is not None and len(feature_pts) < MIN_FEATURES:\n            new_pts = seed_features(gray, SEED_STRIP_PX)\n            if new_pts is not None:\n                feature_pts = np.vstack([feature_pts, new_pts])\n\n        if (prev_gray is not None\n                and feature_pts is not None\n                and len(feature_pts) > 0):\n            next_pts, status, _ = cv2.calcOpticalFlowPyrLK(\n                prev_gray, gray, feature_pts, None, **_lk_params)\n            flux.update(feature_pts, next_pts, status)\n            ok          = status.flatten() == 1\n            feature_pts = next_pts[ok].reshape(-1, 1, 2)\n\n        if frame_num % 250 == 0:\n            pct         = frame_num / total_frames * 100\n            elapsed     = time.time() - start_time\n            fps_actual  = frame_num / max(elapsed, 0.001)\n            remaining   = (total_frames - frame_num) / max(fps_actual, 0.001)\n            e_mins, e_secs = int(elapsed // 60), int(elapsed % 60)\n            r_mins, r_secs = int(remaining // 60), int(remaining % 60)\n            print(f\"  {frame_num}/{total_frames} ({pct:.1f}%)  \"\n                  f\"HEAD IN={head.count_in} OUT={head.count_out}  |  \"\n                  f\"elapsed={e_mins}m{e_secs:02d}s  \"\n                  f\"remaining≈{r_mins}m{r_secs:02d}s  \"\n     